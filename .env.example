# PaceSense Studio settings (all optional). Copy to .env and edit. See src/pacesense/studio/settings.py.
PACESENSE_DB=/data/pacesense.sqlite3
# PACESENSE_DATA=/app/data/races.csv      # race CSV from `pacesense import`; synthetic demo data if unset
PACESENSE_LOG_LEVEL=INFO
PACESENSE_LOG_FORMAT=json
PACESENSE_SESSION_TTL=3600
PACESENSE_MAX_SESSIONS=200
# PACESENSE_CORS_ORIGINS=https://your-site.example
# PACESENSE_AI=1                          # optional AI assistant (needs an OpenRouter key in settings)
